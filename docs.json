{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cartão Simples",
  "colors": {
    "primary": "#3A36F5",
    "light": "#555EFF",
    "dark": "#1A15B8"
  },
  "appearance": {
    "default": "light"
  },
  "openapi": ["/openapi.yaml"],
  "favicon": "/favicon.svg",
  "redirects": [
    {
      "source": "/",
      "destination": "/pages/introduction"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentação",
        "groups": [
          {
            "group": "Introdução",
            "pages": [
              "pages/introduction",
              "pages/development",
              "pages/authentication",
              "pages/webhooks",
              "pages/test-cards"
            ]
          },
          {
            "group": "Autenticação",
            "pages": ["pages/authentication/access-token"]
          }
        ]
      },
      {
        "tab": "CDC",
        "groups": [
          {
            "group": "Fluxo",
            "pages": ["pages/flow"]
          },
          {
            "group": "Pedido",
            "pages": [
              "pages/orders/validate-cdc-customer",
              "pages/orders/start-cdc-sale"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Cartão Simples",
      "href": "https://www.cartaosimples.com.br"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Twila-Digital",
      "linkedin": "https://www.linkedin.com/company/twila-tecnologia"
    }
  }
}
