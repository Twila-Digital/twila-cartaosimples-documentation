{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Parcele+",
  "colors": {
    "primary": "#3A36F5",
    "light": "#555EFF",
    "dark": "#1A15B8"
  },
  "appearance": {
    "default": "light"
  },
  "openapi": ["/openapi.yaml"],
  "favicon": "/favicon.svg",
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/pages/introduction"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Comece aqui",
        "groups": [
          {
            "group": "Comece aqui",
            "pages": ["pages/introduction"]
          }
        ]
      },
      {
        "tab": "Para Lojistas",
        "groups": [
          {
            "group": "Entenda o produto",
            "pages": ["pages/for-merchants"]
          }
        ]
      },
      {
        "tab": "Para Desenvolvedores",
        "groups": [
          {
            "group": "Integração",
            "pages": [
              "pages/for-developers",
              "pages/development",
              "pages/test-cards",
              "pages/errors"
            ]
          }
        ]
      },
      {
        "tab": "Autenticação",
        "groups": [
          {
            "group": "Autenticação",
            "pages": [
              "pages/authentication",
              "pages/authentication/access-token"
            ]
          }
        ]
      },
      {
        "tab": "CDC",
        "groups": [
          {
            "group": "Fluxo",
            "pages": ["pages/flow"]
          },
          {
            "group": "Pedido",
            "pages": [
              "pages/orders/validate-cdc-customer",
              "pages/orders/start-cdc-sale",
              "pages/orders/import-invoice",
              "pages/orders/get",
              "pages/orders/paged"
            ]
          },
          {
            "group": "Simulador",
            "pages": [
              "pages/orders/simulate-installments",
              "pages/orders/simulate-values"
            ]
          },
          {
            "group": "Cliente",
            "pages": [
              "pages/customers/get",
              "pages/customers/paged"
            ]
          }
        ]
      },
      {
        "tab": "Webhooks",
        "groups": [
          {
            "group": "Visão geral",
            "pages": ["pages/webhooks", "pages/webhooks/security"]
          },
          {
            "group": "Webhooks",
            "pages": [
              "pages/webhooks/create",
              "pages/webhooks/list",
              "pages/webhooks/update",
              "pages/webhooks/delete"
            ]
          }
        ]
      },
      {
        "tab": "SDKs",
        "groups": [
          {
            "group": "Oficiais",
            "pages": ["pages/sdks/sdks", "pages/sdks/dotnet"]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "llms.txt",
        "href": "/llms.txt"
      },
      {
        "label": "GitHub",
        "icon": "github",
        "href": "https://github.com/Twila-Digital/twila-parcelemais-dotnet-sdk"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Parcele+",
      "href": "https://www.cartaosimples.com.br"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Twila-Digital/twila-cartaosimples-documentation",
      "linkedin": "https://www.linkedin.com/company/twila-tecnologia"
    }
  }
}
